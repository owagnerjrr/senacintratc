rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function administrator(){return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
  match /admins/{uid}{allow read: if request.auth != null && request.auth.uid == uid;allow write: if false;}
  match /links/{id}{allow read: if true;allow create,update,delete: if administrator();}
  match /notices/{id}{allow read: if true;allow create,update,delete: if administrator();}
  match /{document=**}{allow read,write: if false;}
 }
}